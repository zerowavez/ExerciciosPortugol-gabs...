programa
{
	
	funcao inicio()
	{
		inteiro num1, num2, num3, num4, num5, num6
		escreva("Digite 6 números... ")
		leia(num1, num2, num3, num4, num5, num6)

		inteiro soma = num1 + num2 + num3 + num4 + num5 + num6
		inteiro media = soma / 6
		
		escreva("a media dos números: ", num1, " ", num2, " ", num3,
		" ", num4, " ", num5, " e ", num6,
		"\n", "é igual a: ", media)
	}
}
