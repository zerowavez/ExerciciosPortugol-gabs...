programa
{
	
	funcao inicio()
	{
		inteiro num1
		escreva("Digite um número... ")
		leia(num1)

		se (num1 > 0) {
			escreva(num1, " é um número POSITIVO!")
		} senao se (num1 == 0) {
			escreva(num1, " é igual a ZERO") 
		} senao {
			escreva(num1, " é um número NEGATIVO")
		}
	}
}
